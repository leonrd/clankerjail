#!/usr/bin/env bash

set -euo pipefail

__dir="$(cd "$(dirname "$0")" && pwd)"
CLANKERJAIL_DIR="$(cd "${__dir}/.." && pwd)"

AGENT_UID="${AGENT_UID:-$(id -u 2>/dev/null || echo 1000)}"
AGENT_GID="${AGENT_GID:-$(id -g 2>/dev/null || echo 1000)}"

for arg in "$@"; do
	extra_args=()
  case "${arg}" in
    --dry-run)
      extra_args+=("${arg}")
      ;;
    --no-cache)
      extra_args+=("${arg}")
      ;;
    *)
      ;;
  esac
done

docker compose \
  -f "${CLANKERJAIL_DIR}/docker/docker-compose.yml" \
  build \
    --build-arg AGENT_UID="${AGENT_UID}" \
    --build-arg AGENT_GID="${AGENT_GID}" \
    "${extra_args[@]}"
