#!/usr/bin/env bash

set -eo pipefail

__dir="$(cd "$(dirname "$0")" && pwd)"
CLANKERJAIL_DIR="$(cd "${__dir}/.." && pwd)"

AGENT_UID=$(id -u 2>/dev/null || echo 1000)
AGENT_GID=$(id -g 2>/dev/null || echo 1000)

for arg in "$@"; do
  case "${arg}" in
    --skip-image-build)
      SKIP_IMAGE_BUILD=1
      ;;
    --install-dotfiles)
      INSTALL_DOTFILES=1
      ;;
    *)
      WORKSPACE="${arg}"
      ;;
  esac
done

if [ "${SKIP_IMAGE_BUILD}" != 1 ]; then
  AGENT_UID="${AGENT_UID}" \
  AGENT_GID="${AGENT_GID}" \
    ${__dir}/clankerjail-build
fi

. "${CLANKERJAIL_DIR}/helpers/get_tz.sh"

CLANKERJAIL_STATE_DIR=${CLANKERJAIL_STATE_DIR:-"${HOME}/.local/state/clankerjail"}
CLANKERJAIL_AGENT_USER_HOME_DIR=${CLANKERJAIL_AGENT_USER_HOME_DIR:-"${CLANKERJAIL_STATE_DIR}/home/agent"}

WORKSPACE="${WORKSPACE:-.}"
# Adjust workspace for relative path support
case "${WORKSPACE}" in
  .) ;;
  /*) ;;
  ./*) ;;
  ../*) ;;
  *) WORKSPACE="./${WORKSPACE}" ;;
esac

# Prepare dirs
mkdir -p "${CLANKERJAIL_STATE_DIR}"
mkdir -p "${CLANKERJAIL_AGENT_USER_HOME_DIR}"

if [ "${INSTALL_DOTFILES}" = 1 ]; then
  curl -fsSL "${DOTFILES_INSTALL_URL:-https://raw.githubusercontent.com/leonrd/dotfiles/HEAD/.local/share/dotfiles/dotfiles-install.sh}" \
  | DOTFILES_REPO="${DOTFILES_REPO:-https://github.com/leonrd/dotfiles.git}" \
    DOTFILES_HOME_DIR="${CLANKERJAIL_AGENT_USER_HOME_DIR}" \
    sh
fi

msb run clankerjail \
  --env TZ=$(get_tz) \
  --env ANTHROPIC_BASE_URL="${ANTHROPIC_BASE_URL}" \
  $( [ -n "${ANTHROPIC_API_KEY}" ] && echo "--secret ANTHROPIC_API_KEY@api.anthropic.com" ) \
  --env OPENAI_BASE_URL="${OPENAI_BASE_URL}" \
  $( [ -n "${OPENAI_API_KEY}" ] && echo "--secret OPENAI_API_KEY@api.openai.com" ) \
  --env OPENROUTER_BASE_URL="${OPENROUTER_BASE_URL}" \
  $( [ -n "${OPENROUTER_API_KEY}" ] && echo "--secret OPENROUTER_API_KEY@openrouter.ai" ) \
  --tmpfs /tmp:4G:nodev,nosuid \
  --mount-dir "${CLANKERJAIL_AGENT_USER_HOME_DIR:-${CLANKERJAIL_STATE_DIR:-${HOME}/.local/state/clankerjail}/home/agent}:/home/agent" \
  $( [ -n "${WORKSPACE}" ] && echo "--mount-dir ${WORKSPACE}:/workspace" ) \

