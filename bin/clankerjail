#!/usr/bin/env bash

set -eo pipefail

__dir="$(cd "$(dirname "$0")" && pwd)"
CLANKERJAIL_DIR="$(cd "${__dir}/.." && pwd)"

AGENT_UID=$(id -u 2>/dev/null || echo 1000)
AGENT_GID=$(id -g 2>/dev/null || echo 1000)

for arg in "$@"; do
  case "${arg}" in
    --dry-run)
      DRY_RUN=1
      ;;
    --skip-image-build)
      SKIP_IMAGE_BUILD=1
      ;;
    --print-config)
      PRINT_CONFIG=1
      ;;
    --install-dotfiles)
      INSTALL_DOTFILES=1
      ;;
    *)
      WORKSPACE="${arg}"
      ;;
  esac
done

if [ "${SKIP_IMAGE_BUILD}" != 1 ]; then
  AGENT_UID="${AGENT_UID}" \
  AGENT_GID="${AGENT_GID}" \
    ${__dir}/clankerjail-build \
    $( [ "${DRY_RUN}" = 1 ] && echo "--dry-run" )
fi

. "${CLANKERJAIL_DIR}/helpers/get_tz.sh"

CLANKERJAIL_STATE_DIR=${CLANKERJAIL_STATE_DIR:-"${HOME}/.local/state/clankerjail"}
CLANKERJAIL_AGENT_USER_HOME_DIR=${CLANKERJAIL_AGENT_USER_HOME_DIR:-"${CLANKERJAIL_STATE_DIR}/home/agent"}

WORKSPACE="${WORKSPACE:-.}"
# Adjust workspace for relative path support
case "${WORKSPACE}" in
  .) ;;
  /*) ;;
  ./*) ;;
  ../*) ;;
  *) WORKSPACE="./${WORKSPACE}" ;;
esac

# Prepare dirs
if [ "${DRY_RUN}" != 1 ]; then
  mkdir -p "${CLANKERJAIL_STATE_DIR}"
  mkdir -p "${CLANKERJAIL_AGENT_USER_HOME_DIR}"
fi

run_compose() {
  CLANKERJAIL_STATE_DIR="${CLANKERJAIL_STATE_DIR}" \
  CLANKERJAIL_AGENT_USER_HOME_DIR="${CLANKERJAIL_AGENT_USER_HOME_DIR}" \
  TZ=$(get_tz) \
  AGENT_UID="${AGENT_UID}" \
  AGENT_GID="${AGENT_GID}" \
  ANTHROPIC_BASE_URL="${ANTHROPIC_BASE_URL}" \
  ANTHROPIC_API_KEY="${ANTHROPIC_API_KEY}" \
  ANTHROPIC_AUTH_TOKEN="${ANTHROPIC_AUTH_TOKEN}" \
  OPENAI_BASE_URL="${OPENAI_BASE_URL}" \
  OPENAI_API_KEY="${OPENAI_API_KEY}" \
  OPENROUTER_BASE_URL="${OPENROUTER_BASE_URL}" \
  OPENROUTER_API_KEY="${OPENROUTER_API_KEY}" \
  docker compose \
    $( [ "${DRY_RUN}" = 1 ] && echo "--dry-run" ) \
    -f "${CLANKERJAIL_DIR}/docker/docker-compose.yml" \
    "$@"
}

if [ "${PRINT_CONFIG}" = 1 ]; then
  run_compose config
fi

if [ "${INSTALL_DOTFILES}" = 1 ] && [ "${DRY_RUN}" != 1 ]; then
  curl -fsSL "${DOTFILES_INSTALL_URL:-https://raw.githubusercontent.com/leonrd/dotfiles/HEAD/.local/share/dotfiles/dotfiles-install.sh}" \
  | DOTFILES_REPO="${DOTFILES_REPO:-https://github.com/leonrd/dotfiles.git}" \
    DOTFILES_HOME_DIR="${CLANKERJAIL_AGENT_USER_HOME_DIR}" \
    sh
fi

run_compose run \
  --volume "${WORKSPACE}:/workspace" \
  --rm \
  runner
