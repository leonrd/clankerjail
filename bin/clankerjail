#!/usr/bin/env bash

set -eo pipefail

__dir=$(dirname "$(readlink -f "$0")")
CLANKERJAIL_DIR="$(cd "${__dir}/.." && pwd)"
echo $CLANKERJAIL_DIR

parse_flags() {
  extra_args=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -w|--workspace)
        WORKSPACE="${arg}"
        ;;
      *)
        extra_args+=("$1")
        shift
        ;;
    esac
  done
}

parse_flags "$@"

. "${CLANKERJAIL_DIR}/helpers/get_tz.sh"

CLANKERJAIL_STATE_DIR=${CLANKERJAIL_STATE_DIR:-"${HOME}/.local/state/clankerjail"}
CLANKERJAIL_AGENT_USER_HOME_DIR=${CLANKERJAIL_AGENT_USER_HOME_DIR:-"${CLANKERJAIL_STATE_DIR}/home/agent"}

# Prepare dirs
mkdir -p "${CLANKERJAIL_STATE_DIR}"
mkdir -p "${CLANKERJAIL_AGENT_USER_HOME_DIR}"

ulimit -n 1048576
msb run clankerjail \
  --env TZ=$(get_tz) \
  --env ANTHROPIC_BASE_URL="${ANTHROPIC_BASE_URL}" \
  $( [ -n "${ANTHROPIC_API_KEY}" ] && echo "--secret ANTHROPIC_API_KEY@api.anthropic.com" ) \
  --env OPENAI_BASE_URL="${OPENAI_BASE_URL}" \
  $( [ -n "${OPENAI_API_KEY}" ] && echo "--secret OPENAI_API_KEY@api.openai.com" ) \
  --env OPENROUTER_BASE_URL="${OPENROUTER_BASE_URL}" \
  $( [ -n "${OPENAI_API_KEY}" ] && echo "--secret OPENAI_API_KEY@api.openai.com" ) \
  $( [ -n "${NEURALWATT_API_KEY}" ] && echo "--secret NEURALWATT_API_KEY@api.neuralwatt.com" ) \
  --tmpfs /tmp:4G:nodev,nosuid \
  --mount-dir "${CLANKERJAIL_AGENT_USER_HOME_DIR:-${CLANKERJAIL_STATE_DIR:-${HOME}/.local/state/clankerjail}/home/agent}:/home/agent:host-perms=mirror" \
  $( [ -n "${WORKSPACE}" ] && echo "--mount-dir ${WORKSPACE}:/workspace" -w "/workspace" ) \
  --net-default-egress deny \
  --net-rule "allow@public:tcp:443" \
  --net-rule "allow@host:udp:53" \
  "${extra_args[@]}" \

